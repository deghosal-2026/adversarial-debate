+func (w *WAL) LatestSnapshotEntry() (*walpb.Snapshot, error) {
+	walSnaps, err := ValidSnapshotEntries(w.lg, w.dir)
+	if err != nil || len(walSnaps) == 0 {
+		return &walpb.Snapshot{}, err
+	}
+
+	return walSnaps[len(walSnaps)-1], nil
+}
